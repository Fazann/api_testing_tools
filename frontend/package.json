{
  "name": "api-test-kits-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" vite.config.ts",
    "lint": "prettier --check \"src/**/*.{ts,vue,css}\" vite.config.ts && node scripts/check-line-length.mjs"
  },
  "dependencies": {
    "pinia": "2.3.1",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "16.8.1",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5",
    "vue-tsc": "2.2.0"
  }
}
